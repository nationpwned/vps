#!/bin/bash

# Path Konfigurasi
CONFIG_XRAY="/usr/local/etc/xray/config.json"
CONFIG_NGINX="/etc/nginx/sites-available/xray"
NGINX_LINK="/etc/nginx/sites-enabled/xray"
DOMAIN_FILE="/usr/local/etc/xray/domain.txt"

# Definisi Warna (UI)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# 1. Setup Firewall & Dependencies
setup_env() {
    echo -e "${YELLOW}Mengonfigurasi Firewall & Dependencies...${NC}"
    apt update && apt install -y ufw nginx jq curl socat certbot python3-certbot-nginx openssl
    ufw allow 22/tcp && ufw allow 80/tcp && ufw allow 443/tcp
    echo "y" | ufw enable
}

# 2. Fungsi Reinstall (Pembersihan Total)
reinstall_script() {
    clear
    echo -e "${RED}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "│                ${WHITE}WARNING: REINSTALL SYSTEM${NC}                 │"
    echo -e "├──────────────────────────────────────────────────────────┤"
    echo -e "│ Semua data user, SSL, dan konfigurasi akan DIHAPUS!     │"
    echo -e "└──────────────────────────────────────────────────────────┘"
    read -p "  Apakah Anda yakin? (y/n): " confirm
    if [[ $confirm == [yY] ]]; then
        systemctl stop xray nginx 2>/dev/null
        rm -rf /usr/local/etc/xray/
        rm -f $CONFIG_NGINX $NGINX_LINK
        rm -rf /etc/systemd/system/xray.service.d
        echo -e "${GREEN}Pembersihan selesai. Mengulang instalasi...${NC}"
        sleep 2
        install_all
    else
        main_menu
    fi
}

# 3. Proses Instalasi Utama
install_all() {
    clear
    echo -e "${CYAN}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "│                ${WHITE}INITIAL INSTALLATION${NC}                  │"
    echo -e "└──────────────────────────────────────────────────────────┘"
    
    read -p "  Masukkan Domain Anda : " DOMAIN
    read -p "  Masukkan Email SSL   : " EMAIL
    if [[ -z "$DOMAIN" || -z "$EMAIL" ]]; then echo -e "${RED}Error: Data tidak lengkap!${NC}"; exit 1; fi
    
    setup_env
    systemctl stop apache2 2>/dev/null && apt remove -y apache2 2>/dev/null

    echo -e "${YELLOW}Installing Xray-core...${NC}"
    bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install

    # Generate Admin Awal
    mkdir -p /usr/local/etc/xray/
    ADMIN_UUID=$(cat /proc/sys/kernel/random/uuid)
    ADMIN_PASS=$(openssl rand -hex 6)

    # Nginx SSL & Proxy Setup
    cat <<EOF > $CONFIG_NGINX
server { listen 80; server_name $DOMAIN; root /var/www/html; }
EOF
    ln -sf $CONFIG_NGINX $NGINX_LINK
    rm -f /etc/nginx/sites-enabled/default 2>/dev/null
    systemctl restart nginx
    certbot --nginx -d $DOMAIN --non-interactive --agree-tos -m $EMAIL

    cat <<EOF > $CONFIG_NGINX
server {
    listen 443 ssl http2;
    server_name $DOMAIN;
    ssl_certificate /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    location /vless-ws { proxy_pass http://127.0.0.1:10001; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /trojan-ws { proxy_pass http://127.0.0.1:10002; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /vless-grpc { if (\$request_method != "POST") { return 404; } client_max_body_size 0; grpc_pass grpc://127.0.0.1:10003; }
    location /trojan-grpc { if (\$request_method != "POST") { return 404; } client_max_body_size 0; grpc_pass grpc://127.0.0.1:10004; }
    location /vless-upgrade { proxy_pass http://127.0.0.1:10005; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /trojan-upgrade { proxy_pass http://127.0.0.1:10006; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /xhttp { proxy_pass http://127.0.0.1:10007; proxy_http_version 1.1; proxy_set_header Host \$host; }
}
EOF

    # Xray JSON Config
    cat <<EOF > $CONFIG_XRAY
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "port": 10001, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "ws", "wsSettings": { "path": "/vless-ws" } } },
    { "port": 10002, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "ws", "wsSettings": { "path": "/trojan-ws" } } },
    { "port": 10003, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "grpc", "grpcSettings": { "serviceName": "vless-grpc" } } },
    { "port": 10004, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "grpc", "grpcSettings": { "serviceName": "trojan-grpc" } } },
    { "port": 10005, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "httpupgrade", "httpupgradeSettings": { "path": "/vless-upgrade" } } },
    { "port": 10006, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "httpupgrade", "httpupgradeSettings": { "path": "/trojan-upgrade" } } },
    { "port": 10007, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "xhttp", "xhttpSettings": { "path": "/xhttp" } } }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
EOF

    echo "$DOMAIN" > "$DOMAIN_FILE"
    rm -rf /etc/systemd/system/xray.service.d
    systemctl daemon-reload
    systemctl restart nginx && systemctl restart xray
    main_menu
}

# --- Management Users Sub-Menu ---

menu_users() {
    clear
    echo -e "${BLUE}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "│                   ${GREEN}MANAGEMENT USERS${NC}                     │"
    echo -e "├──────────────────────────────────────────────────────────┤"
    echo -e "│  ${CYAN}[1]${NC} Tambah User Baru                            │"
    echo -e "│  ${CYAN}[2]${NC} Hapus User Aktif                            │"
    echo -e "│  ${CYAN}[3]${NC} Lihat Daftar User & Share Link               │"
    echo -e "│  ${CYAN}[4]${NC} Kembali ke Menu Utama                       │"
    echo -e "└──────────────────────────────────────────────────────────┘"
    echo -ne "  ${YELLOW}Pilih menu:${NC} "
    read opt
    case $opt in
        1) add_user ;;
        2) del_user ;;
        3) list_user ;;
        4) main_menu ;;
        *) menu_users ;;
    esac
}

add_user() {
    echo -ne "  Nama User Baru: "
    read USERNAME
    [[ -z "$USERNAME" ]] && menu_users
    UUID=$(cat /proc/sys/kernel/random/uuid)
    PASS=$(openssl rand -hex 6)
    for i in 0 2 4 6; do jq ".inbounds[$i].settings.clients += [{\"id\": \"$UUID\", \"email\": \"$USERNAME\"}]" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
    for i in 1 3 5; do jq ".inbounds[$i].settings.clients += [{\"password\": \"$PASS\", \"email\": \"$USERNAME\"}]" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
    systemctl restart xray
    show_links "$USERNAME" "$UUID" "$PASS"
}

show_links() {
    local USER=$1; local UUID=$2; local PASS=$3; local DOMAIN=$(cat $DOMAIN_FILE)
    clear
    echo -e "${CYAN}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "  ${GREEN}MIHOMO / CLASH META CONFIG FOR:${NC} ${YELLOW}$USER${NC}"
    echo -e "├──────────────────────────────────────────────────────────┤"
    cat <<EOF
proxies:
  - name: $USER-vless-ws
    server: $DOMAIN
    port: 443
    type: vless
    uuid: $UUID
    cipher: auto
    tls: true
    skip-cert-verify: true
    servername: $DOMAIN
    network: ws
    ws-opts:
      path: /vless-ws
      headers:
        Host: $DOMAIN
    udp: true

  - name: $USER-vless-grpc
    type: vless
    server: $DOMAIN
    port: 443
    uuid: $UUID
    tls: true
    skip-cert-verify: true
    servername: $DOMAIN
    network: grpc
    grpc-opts:
      grpc-service-name: vless-grpc
    udp: true

  - name: $USER-vless-upgrade
    server: $DOMAIN
    port: 443
    type: vless
    skip-cert-verify: true
    uuid: $UUID
    cipher: auto
    tls: true
    servername: $DOMAIN
    network: ws
    ws-opts:
      path: /vless-upgrade
      headers:
        Host: $DOMAIN
      v2ray-http-upgrade: true
    udp: true

  - name: $USER-vless-xhttp
    type: vless
    server: $DOMAIN
    port: 443
    uuid: $UUID
    skip-cert-verify: true
    cipher: auto
    tls: true
    servername: $DOMAIN
    network: xhttp
    xhttp-opts:
      path: /xhttp
      mode: stream
    udp: true

  - name: $USER-trojan-ws
    server: $DOMAIN
    port: 443
    type: trojan
    password: $PASS
    skip-cert-verify: true
    sni: $DOMAIN
    tls: true
    network: ws
    ws-opts:
      path: /trojan-ws
      headers:
        Host: $DOMAIN
    udp: true

  - name: $USER-trojan-upgrade
    server: $DOMAIN
    port: 443
    type: trojan
    password: $PASS
    skip-cert-verify: true
    sni: $DOMAIN
    tls: true
    network: ws
    ws-opts:
      path: /trojan-upgrade
      headers:
        Host: $DOMAIN
      v2ray-http-upgrade: true
    udp: true

  - name: $USER-trojan-grpc
    type: trojan
    server: $DOMAIN
    port: 443
    password: $PASS
    skip-cert-verify: true
    sni: $DOMAIN
    tls: true
    network: grpc
    grpc-opts:
      grpc-service-name: trojan-grpc
    udp: true
EOF
    echo -e "└──────────────────────────────────────────────────────────┘"
    read -p "Tekan Enter..."
    menu_users
}

list_user() {
    clear
    USERS=$(jq -r '.inbounds[0].settings.clients[].email' $CONFIG_XRAY)
    [[ -z "$USERS" ]] && menu_users
    select USERNAME in $USERS "Kembali"; do
        [[ "$USERNAME" == "Kembali" ]] && menu_users
        UUID=$(jq -r ".inbounds[0].settings.clients[] | select(.email==\"$USERNAME\") | .id" $CONFIG_XRAY)
        PASS=$(jq -r ".inbounds[1].settings.clients[] | select(.email==\"$USERNAME\") | .password" $CONFIG_XRAY)
        show_links "$USERNAME" "$UUID" "$PASS"; break
    done
}

del_user() {
    clear
    USERS=$(jq -r '.inbounds[0].settings.clients[].email' $CONFIG_XRAY)
    select USERNAME in $USERS "Batal"; do
        [[ "$USERNAME" == "Batal" ]] && menu_users
        for i in {0..6}; do jq ".inbounds[$i].settings.clients |= del(.[] | select(.email == \"$USERNAME\"))" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
        systemctl restart xray; menu_users; break
    done
}

# --- Dashboard Utama ---

main_menu() {
    clear
    DOMAIN=$(cat $DOMAIN_FILE 2>/dev/null || echo "Belum Setup")
    RAM=$(free -m | awk '/Mem:/ { print $3 "MB / " $2 "MB" }')
    CPU=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}')%

    echo -e "${BLUE}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "│                ${GREEN}XRAY ULTIMATE DASHBOARD${NC}                 │"
    echo -e "├──────────────────────────────────────────────────────────┤"
    echo -e "│  ${YELLOW}DOMAIN${NC}  : $DOMAIN"
    echo -e "│  ${YELLOW}RAM${NC}     : $RAM"
    echo -e "│  ${YELLOW}CPU${NC}     : $CPU Usage"
    echo -e "├──────────────────────────────────────────────────────────┤"
    echo -e "│  ${CYAN}[1]${NC} Management Users                            │"
    echo -e "│  ${CYAN}[2]${NC} Check Services                              │"
    echo -e "│  ${PURPLE}[R]${NC} Reinstall Script (Reset Total)               │"
    echo -e "│  ${CYAN}[3]${NC} Quit (Exit)                                 │"
    echo -e "└──────────────────────────────────────────────────────────┘"
    echo -ne "  ${YELLOW}Pilih menu:${NC} "
    read opt
    case $opt in
        1) menu_users ;;
        2) check_services ;;
        [rR]) reinstall_script ;;
        3) exit ;;
        *) main_menu ;;
    esac
}

check_services() {
    clear
    echo -e "Xray  : $(systemctl is-active xray)"
    echo -e "Nginx : $(systemctl is-active nginx)"
    read -p "Enter..."
    main_menu
}

check_install() {
    [[ -f "$CONFIG_XRAY" ]] && main_menu || install_all
}

check_install
