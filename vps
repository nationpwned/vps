#!/bin/bash

# --- Konfigurasi Path ---
CONFIG_DIR="/etc/sing-box"
CONFIG_FILE="$CONFIG_DIR/config.json"
EXPIRY_FILE="$CONFIG_DIR/expiry.dat"
NGINX_DIR="/etc/nginx/conf.d"
NGINX_CONF="$NGINX_DIR/proxy.conf"
CERT_BASE="/etc/letsencrypt/live"
SUB_DIR="/var/www/sub"

# --- Warna Tampilan ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

# Ambil Domain dari Nginx
DOMAIN=$(grep "server_name" $NGINX_CONF 2>/dev/null | awk '{print $2}' | sed 's/;//')

# --- Fungsi Cek Instalasi ---
check_installation() {
    [ -f "$CONFIG_FILE" ] && [ "$(docker ps -q -f name=sing-box 2>/dev/null)" ]
}

# --- Fungsi Wipe & Reset ---
wipe_system() {
    echo -e "${RED}WIPE SYSTEM (KEEP SSL CERT)${NC}"
    read -p "Lanjutkan proses Wipe? (y/n): " CONFIRM
    if [[ "$CONFIRM" == "y" ]]; then
        docker stop sing-box nginx 2>/dev/null
        docker rm sing-box nginx 2>/dev/null
        rm -rf "$CONFIG_DIR" "$NGINX_DIR" "$SUB_DIR"
        crontab -l 2>/dev/null | grep -v "acme.sh" | crontab -
        echo -e "${GREEN}Wipe Selesai!${NC}"
        exit
    fi
}

# --- Fungsi Update File Sub ---
sub_files() {
    mkdir -p "$SUB_DIR"
    rm -rf "$SUB_DIR"/*
    # Mengambil user unik dari inbounds
    jq -c '.inbounds[] | select(.tag=="vless-ws") | .users[]' "$CONFIG_FILE" 2>/dev/null | while read -r user; do
        name=$(echo "$user" | jq -r '.name')
        uuid=$(echo "$user" | jq -r '.uuid')
        pass=$(jq -r --arg n "$name" '.inbounds[] | select(.tag=="trojan-ws") | .users[] | select(.name==$n) | .password' "$CONFIG_FILE")
        
        V_WS="vless://$uuid@$DOMAIN:443?path=%2Fvless-ws&security=tls&encryption=none&type=ws#$name-VLESS-WS"
        V_GRPC="vless://$uuid@$DOMAIN:443?serviceName=vless-grpc&security=tls&encryption=none&type=grpc#$name-VLESS-gRPC"
        V_UP="vless://$uuid@$DOMAIN:443?path=%2Fvless-httpupgrade&security=tls&encryption=none&type=httpupgrade#$name-VLESS-Upgrade"
        T_WS="trojan://$pass@$DOMAIN:443?path=%2Ftrojan-ws&security=tls&type=ws#$name-Trojan-WS"
        T_GRPC="trojan://$pass@$DOMAIN:443?serviceName=trojan-grpc&security=tls&type=grpc#$name-Trojan-gRPC"
        T_UP="trojan://$pass@$DOMAIN:443?path=%2Ftrojan-httpupgrade&security=tls&type=httpupgrade#$name-Trojan-Upgrade"
        
        printf '%s\n' "$V_WS" "$V_GRPC" "$V_UP" "$T_WS" "$T_GRPC" "$T_UP" > "$SUB_DIR/$name"
    done
}

# --- Fungsi Instalasi ---
install_process() {
    clear
    read -p "Masukkan Domain: " DOMAIN
    read -p "Masukkan Email SSL: " EMAIL
    CERT_PATH="$CERT_BASE/$DOMAIN"
    
    apt-get update && apt-get install -y jq curl openssl cron
    ! [ -x "$(command -v docker)" ] && curl -fsSL https://get.docker.com | sh && systemctl enable --now docker
    
    mkdir -p "$CONFIG_DIR" "$NGINX_DIR" "$CERT_PATH" "$SUB_DIR"
    
    # Hentikan nginx sementara agar port 80 bebas untuk validasi cert
    docker stop nginx 2>/dev/null
    if [ ! -f "$CERT_PATH/fullchain.pem" ] || [ ! -s "$CERT_PATH/fullchain.pem" ]; then
        docker run --rm -p 80:80 -v "$CERT_PATH":/acme.sh neilpang/acme.sh \
            --issue --standalone -d "$DOMAIN" --email "$EMAIL" --server letsencrypt
        # Buat symlink agar Nginx bisa menemukan cert di path yang diharapkan
        if [ -f "$CERT_PATH/${DOMAIN}_ecc/fullchain.cer" ]; then
            ln -sf "$CERT_PATH/${DOMAIN}_ecc/fullchain.cer" "$CERT_PATH/fullchain.pem"
            ln -sf "$CERT_PATH/${DOMAIN}_ecc/${DOMAIN}.key" "$CERT_PATH/privkey.pem"
            echo -e "${GREEN}Sertifikat SSL berhasil diterbitkan!${NC}"
        else
            echo -e "${RED}GAGAL: Sertifikat tidak terbuat. Cek log di atas.${NC}"
            exit 1
        fi
    fi

    cat <<EOF > "$CONFIG_FILE"
{
  "log": { "level": "info" },
  "dns": {
    "servers": [
      { "type": "udp", "tag": "google", "server": "8.8.8.8" }
    ],
    "final": "google"
  },
  "inbounds": [
    { "type": "vless", "tag": "vless-ws", "listen": "127.0.0.1", "listen_port": 10001, "users": [], "transport": { "type": "ws", "path": "/vless-ws" } },
    { "type": "vless", "tag": "vless-grpc", "listen": "127.0.0.1", "listen_port": 10002, "users": [], "transport": { "type": "grpc", "service_name": "vless-grpc" } },
    { "type": "vless", "tag": "vless-upgrade", "listen": "127.0.0.1", "listen_port": 10003, "users": [], "transport": { "type": "httpupgrade", "path": "/vless-httpupgrade" } },
    { "type": "trojan", "tag": "trojan-ws", "listen": "127.0.0.1", "listen_port": 10004, "users": [], "transport": { "type": "ws", "path": "/trojan-ws" } },
    { "type": "trojan", "tag": "trojan-grpc", "listen": "127.0.0.1", "listen_port": 10005, "users": [], "transport": { "type": "grpc", "service_name": "trojan-grpc" } },
    { "type": "trojan", "tag": "trojan-upgrade", "listen": "127.0.0.1", "listen_port": 10006, "users": [], "transport": { "type": "httpupgrade", "path": "/trojan-httpupgrade" } }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}]
}
EOF

    cat <<EOF > "$NGINX_CONF"
server {
    listen 443 ssl;
    http2 on;
    server_name $DOMAIN;
    ssl_certificate $CERT_PATH/fullchain.pem;
    ssl_certificate_key $CERT_PATH/privkey.pem;

    location /sub/ {
        alias /var/www/sub/;
        default_type text/plain;
        autoindex on;
    }

    location /vless-ws { proxy_pass http://127.0.0.1:10001; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$http_host; }
    location /vless-grpc { client_max_body_size 0; grpc_pass grpc://127.0.0.1:10002; }
    location /vless-httpupgrade { proxy_pass http://127.0.0.1:10003; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$http_host; }
    location /trojan-ws { proxy_pass http://127.0.0.1:10004; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$http_host; }
    location /trojan-grpc { client_max_body_size 0; grpc_pass grpc://127.0.0.1:10005; }
    location /trojan-httpupgrade { proxy_pass http://127.0.0.1:10006; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$http_host; }
}
EOF

    docker stop sing-box nginx 2>/dev/null && docker rm sing-box nginx 2>/dev/null
    docker run -d --name sing-box --restart always --network host -v "$CONFIG_DIR":"$CONFIG_DIR" ghcr.io/sagernet/sing-box run -c "$CONFIG_FILE"
    
    # PERBAIKAN: Mount folder SUB_DIR ke dalam container Nginx
    docker run -d --name nginx --restart always --network host \
        -v "$NGINX_DIR":/etc/nginx/conf.d \
        -v "/etc/letsencrypt":"/etc/letsencrypt" \
        -v "$SUB_DIR":"/var/www/sub" \
        nginx:alpine
    
    (crontab -l 2>/dev/null | grep -v "acme.sh"; echo "0 3 1 * * docker stop nginx && docker run --rm -v $CERT_PATH:/acme.sh neilpang/acme.sh --renew -d $DOMAIN --force && ln -sf $CERT_PATH/${DOMAIN}_ecc/fullchain.cer $CERT_PATH/fullchain.pem && ln -sf $CERT_PATH/${DOMAIN}_ecc/${DOMAIN}.key $CERT_PATH/privkey.pem && docker start nginx") | crontab -
    echo -e "${GREEN}Instalasi Selesai!${NC}"
}

# --- Menu Loop ---
while true; do
    clear
    if ! check_installation; then
        echo -e "${RED}Sing-box Belum Terinstall.${NC}"
        read -p "Install sekarang? (y/n): " I_CONFIRM
        [[ "$I_CONFIRM" == "y" ]] && install_process || exit
        DOMAIN=$(grep "server_name" $NGINX_CONF 2>/dev/null | awk '{print $2}' | sed 's/;//')
    fi

    echo -e "${BLUE}      SING-BOX MANAGER ($DOMAIN)      ${NC}"
    echo -e "1) ${GREEN}Daftar User & Sub Link${NC}"
    echo -e "2) ${YELLOW}Tambah User (Full 6 Protocol)${NC}"
    echo -e "3) ${RED}Hapus User${NC}"
    echo -e "4) ${BLUE}Status Core${NC}"
    echo -e "5) ${RED}Wipe & Reset (Keep SSL)${NC}"
    echo -e "6) Keluar"
    read -p "Pilihan: " OPT
    
    case $OPT in
        1) 
           sub_files
           echo -e "\n${BLUE}========== USER LIST ==========${NC}"
           now=$(date +%s)
           # Ambil user dari config.json untuk melihat expire
           jq -c '.inbounds[] | select(.tag=="vless-ws") | .users[]' "$CONFIG_FILE" 2>/dev/null | while read -r user; do
               uname=$(echo "$user" | jq -r '.name')
               uexp=$(grep "^$uname:" "$EXPIRY_FILE" 2>/dev/null | cut -d: -f2)
               [[ -z "$uexp" ]] && uexp=0
               
               # Logika Tampilan Unlimited
               if [[ "$uexp" == "0" ]]; then
                   expire_status="${GREEN}Unlimited${NC}"
               elif [[ "$now" -gt "$uexp" ]]; then
                   expire_status="${RED}Expired ($(date -d @$uexp +%Y-%m-%d))${NC}"
               else
                   expire_status="${YELLOW}$(date -d @$uexp +%Y-%m-%d)${NC}"
               fi

               echo -e "${PURPLE}User:${NC} $uname | ${PURPLE}Exp:${NC} $expire_status"
               echo -e "${YELLOW}Sub:${NC} https://$DOMAIN/sub/$uname"
               echo "------------------------------------------------------------"
           done
           read -p "Enter untuk kembali..." ;;
        2) 
           read -p "Nama User: " UNAME; read -p "Masa Aktif (hari, 0=unlimit): " DAYS
           [[ "$DAYS" == "0" ]] && EXP=0 || EXP=$(date -d "+$DAYS days" +%s)
           UUID=$(cat /proc/sys/kernel/random/uuid); PASS=$(openssl rand -hex 6)
           tags=("vless-ws" "vless-grpc" "vless-upgrade" "trojan-ws" "trojan-grpc" "trojan-upgrade")
           for tag in "${tags[@]}"; do
               if [[ $tag == vless* ]]; then 
                   jq --arg n "$UNAME" --arg id "$UUID" --arg t "$tag" '(.inbounds[] | select(.tag==$t) | .users) += [{"name":$n, "uuid":$id}]' "$CONFIG_FILE" > /tmp/sb.j && mv /tmp/sb.j "$CONFIG_FILE"
               else 
                   jq --arg n "$UNAME" --arg p "$PASS" --arg t "$tag" '(.inbounds[] | select(.tag==$t) | .users) += [{"name":$n, "password":$p}]' "$CONFIG_FILE" > /tmp/sb.j && mv /tmp/sb.j "$CONFIG_FILE"
               fi
           done
           # Simpan expiry ke file terpisah (sing-box tidak mendukung field custom)
           sed -i "/^$UNAME:/d" "$EXPIRY_FILE" 2>/dev/null; echo "$UNAME:$EXP" >> "$EXPIRY_FILE"
           sub_files && docker restart sing-box; echo -e "${GREEN}User Berhasil Dibuat!${NC}"; sleep 1 ;;
        3) 
           read -p "Hapus Nama User: " D_NAME
           jq --arg n "$D_NAME" '.inbounds[].users |= map(select(.name != $n))' "$CONFIG_FILE" > /tmp/sb.j && mv /tmp/sb.j "$CONFIG_FILE"
           sed -i "/^$D_NAME:/d" "$EXPIRY_FILE" 2>/dev/null
           sub_files && docker restart sing-box; echo "User dihapus."; sleep 1 ;;
        4) 
           docker stats --no-stream sing-box nginx; read -p "Enter untuk kembali..." ;;
        5) 
           wipe_system ;;
        6) 
           exit ;;
    esac
done
