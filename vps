#!/bin/bash

CONFIG_XRAY="/usr/local/etc/xray/config.json"
CONFIG_NGINX="/etc/nginx/sites-available/xray"
NGINX_LINK="/etc/nginx/sites-enabled/xray"
DOMAIN_FILE="/usr/local/etc/xray/domain.txt"
SUB_DIR="/var/www/html/sub"
COUNTRY_CODE=$(curl -s https://api.ip.sb/geoip -4 | jq -r '.country_code')

GREEN='\033[0;32m'
BRIGHT_GREEN='\033[1;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'

show_header() {
    echo -e "${BRIGHT_GREEN}"
    echo "  ██╗  ██╗██████╗  █████╗ ██╗   ██╗    ██████╗ ██████╗  ██████╗ "
    echo "  ╚██╗██╔╝██╔══██╗██╔══██╗╚██╗ ██╔╝    ██╔══██╗██╔══██╗██╔═══██╗"
    echo "   ╚███╔╝ ██████╔╝███████║ ╚████╔╝     ██████╔╝██████╔╝██║   ██║"
    echo "   ██╔██╗ ██╔══██╗██╔══██║  ╚██╔╝      ██╔═══╝ ██╔══██╗██║   ██║"
    echo "  ██╔╝ ██╗██║  ██║██║  ██║   ██║       ██║     ██║  ██║╚██████╔╝"
    echo "  ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝       ╚═╝     ╚═╝  ╚═╝ ╚═════╝ "
    echo -e "${NC}"
}

# ==========================================
# 1. Cloudflare WARP Integration
# ==========================================
install_warp() {
    echo -e "${YELLOW}[!] Injecting Cloudflare WARP...${NC}"
    curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg | gpg --yes --dearmor --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/cloudflare-client.list
    apt update && apt install cloudflare-warp -y
    warp-cli --accept-tos registration delete 2>/dev/null
    warp-cli --accept-tos registration new
    warp-cli --accept-tos mode proxy
    warp-cli --accept-tos proxy port 40000
    warp-cli --accept-tos connect
}

# ==========================================
# 2. System Installation 
# ==========================================
install_all() {
    clear
    show_header
    read -p "  Enter Domain : " DOMAIN
    read -p "  Enter Email  : " EMAIL
    [[ -z "$DOMAIN" || -z "$EMAIL" ]] && exit 1
    
    apt update && apt install -y ufw nginx jq curl socat certbot python3-certbot-nginx openssl lsb-release
    mkdir -p $SUB_DIR
    mkdir -p /usr/local/etc/xray/
    chown -R www-data:www-data /var/www/html
    
    # HTTP Stage for SSL Verification
    cat <<EOF > $CONFIG_NGINX
server { listen 80; server_name $DOMAIN; root /var/www/html; }
EOF
    ln -sf $CONFIG_NGINX $NGINX_LINK
    rm -f /etc/nginx/sites-enabled/default 2>/dev/null
    systemctl restart nginx
    certbot --nginx -d $DOMAIN --non-interactive --agree-tos -m $EMAIL

    # Full Nginx SSL Config
    cat <<EOF > $CONFIG_NGINX
server {
    listen 80; server_name $DOMAIN;
    return 301 https://\$host\$request_uri;
}
server {
    listen 443 ssl http2;
    server_name $DOMAIN;
    ssl_certificate /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    location /sub { alias $SUB_DIR/; default_type text/plain; }
    location /vless-ws { proxy_pass http://127.0.0.1:10001; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /trojan-ws { proxy_pass http://127.0.0.1:10002; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /vless-grpc { if (\$request_method != "POST") { return 404; } client_max_body_size 0; grpc_pass grpc://127.0.0.1:10003; }
    location /trojan-grpc { if (\$request_method != "POST") { return 404; } client_max_body_size 0; grpc_pass grpc://127.0.0.1:10004; }
    location /vless-upgrade { proxy_pass http://127.0.0.1:10005; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
    location /trojan-upgrade { proxy_pass http://127.0.0.1:10006; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; }
}
EOF
    systemctl restart nginx
    install_warp
    bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
    
    # Init Config Xray (Outbound WARP)
    ADMIN_UUID=$(cat /proc/sys/kernel/random/uuid)
    ADMIN_PASS=$(openssl rand -hex 6)
    # Init Config Xray (Full WARP Outbound)
    cat <<EOF > $CONFIG_XRAY
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "port": 10001, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "ws", "wsSettings": { "path": "/vless-ws" } } },
    { "port": 10002, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "ws", "wsSettings": { "path": "/trojan-ws" } } },
    { "port": 10003, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "grpc", "grpcSettings": { "serviceName": "vless-grpc" } } },
    { "port": 10004, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "grpc", "grpcSettings": { "serviceName": "trojan-grpc" } } },
    { "port": 10005, "listen": "127.0.0.1", "protocol": "vless", "settings": { "clients": [{"id": "$ADMIN_UUID", "email": "admin"}], "decryption": "none" }, "streamSettings": { "network": "httpupgrade", "httpupgradeSettings": { "path": "/vless-upgrade" } } },
    { "port": 10006, "listen": "127.0.0.1", "protocol": "trojan", "settings": { "clients": [{"password": "$ADMIN_PASS", "email": "admin"}] }, "streamSettings": { "network": "httpupgrade", "httpupgradeSettings": { "path": "/trojan-upgrade" } } },
  ],
  "outbounds": [
    {
      "protocol": "socks",
      "settings": {
        "servers": [{ "address": "127.0.0.1", "port": 40000 }]
      },
      "tag": "warp"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": ["geoip:private"]
      },
      {
        "type": "field",
        "outboundTag": "warp",
        "network": "tcp,udp"
      }
    ]
  }
}
EOF
    echo "$DOMAIN" > "$DOMAIN_FILE"
    systemctl restart xray
    main_menu
}

# ==========================================
# 3. User & Links Management
# ==========================================
add_user() {
    echo -ne "  [!] Input Target Username: "
    read USERNAME
    [[ -z "$USERNAME" ]] && menu_users
    UUID=$(cat /proc/sys/kernel/random/uuid)
    PASS=$(openssl rand -hex 6)
    DOMAIN=$(cat $DOMAIN_FILE)

    for i in 0 2 4 6; do jq ".inbounds[$i].settings.clients += [{\"id\": \"$UUID\", \"email\": \"$USERNAME\"}]" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
    for i in 1 3 5; do jq ".inbounds[$i].settings.clients += [{\"password\": \"$PASS\", \"email\": \"$USERNAME\"}]" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
    
    # Generate Sub File (Raw Links)
    cat <<EOF > $SUB_DIR/$USERNAME
vless://$UUID@$DOMAIN:443?path=%2Fvless-ws&security=tls&encryption=none&type=ws#vless-ws
vless://$UUID@$DOMAIN:443?mode=multi&serviceName=vless-grpc&security=tls&encryption=none&type=grpc#vless-grpc
vless://$UUID@$DOMAIN:443?path=%2Fvless-upgrade&security=tls&encryption=none&type=httpupgrade#vless-upgrade
trojan://$PASS@$DOMAIN:443?path=%2Ftrojan-ws&security=tls&type=ws#trojan-ws
trojan://$PASS@$DOMAIN:443?mode=multi&serviceName=trojan-grpc&security=tls&type=grpc#trojan-grpc
EOF
    systemctl restart xray
    show_links "$USERNAME" "$UUID" "$PASS"
}

show_links() {
    local USER=$1; local UUID=$2; local PASS=$3; local DOMAIN=$(cat $DOMAIN_FILE)
    local SUB_LINK="https://$DOMAIN/sub/$USER"
    clear
    show_header
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "  ${BRIGHT_GREEN}TARGET:${NC} ${YELLOW}$USER${NC}"
    echo -e "╠══════════════════════════════════════════════════════════╣"
    echo -e "  ${MAGENTA}REMOTE SUBSCRIPTION (RAW LINKS)${NC}"
    echo -e "  ${WHITE}$SUB_LINK${NC}"
    echo -e "╠══════════════════════════════════════════════════════════╣"
    echo -e "  ${CYAN}MIHOMO / CLASH META YAML CONFIGURATION${NC}"
    echo -e "  ${NC}────────────────────────────────────────────────────────"
    cat <<EOF
proxies:
  - name: vless-ws-${COUNTRY_CODE}
    server: support.zoom.us
    port: 443
    type: vless
    uuid: $UUID
    cipher: auto
    tls: true
    skip-cert-verify: true
    servername: $DOMAIN
    network: ws
    ws-opts:
      path: /vless-ws
      headers:
        Host: $DOMAIN
    udp: true

  - name: vless-grpc-${COUNTRY_CODE}
    type: vless
    server: support.zoom.us
    port: 443
    uuid: $UUID
    tls: true
    skip-cert-verify: true
    servername: support.zoom.us.$DOMAIN
    network: grpc
    grpc-opts:
      grpc-service-name: vless-grpc
    udp: true

  - name: vless-upgrade-${COUNTRY_CODE}
    server: support.zoom.us
    port: 443
    type: vless
    skip-cert-verify: true
    uuid: $UUID
    cipher: auto
    tls: true
    servername: $DOMAIN
    network: ws
    ws-opts:
      path: /vless-upgrade
      headers:
        Host: $DOMAIN
      v2ray-http-upgrade: true
    udp: true

  - name: trojan-ws-${COUNTRY_CODE}
    server: support.zoom.us
    port: 443
    type: trojan
    password: $PASS
    skip-cert-verify: true
    sni: $DOMAIN
    tls: true
    network: ws
    ws-opts:
      path: /trojan-ws
      headers:
        Host: $DOMAIN
    udp: true

  - name: trojan-upgrade-${COUNTRY_CODE}
    server: support.zoom.us
    port: 443
    type: trojan
    password: $PASS
    skip-cert-verify: true
    sni: $DOMAIN
    tls: true
    network: ws
    ws-opts:
      path: /trojan-upgrade
      headers:
        Host: $DOMAIN
      v2ray-http-upgrade: true
    udp: true

  - name: trojan-grpc-${COUNTRY_CODE}
    type: trojan
    server: support.zoom.us
    port: 443
    password: $PASS
    skip-cert-verify: true
    sni: support.zoom.us.$DOMAIN
    tls: true
    network: grpc
    grpc-opts:
      grpc-service-name: trojan-grpc
    udp: true
EOF
    echo -e "╚══════════════════════════════════════════════════════════╝"
    read -p "  Press Enter..."
    menu_users
}

main_menu() {
    clear
    show_header
    DOMAIN=$(cat $DOMAIN_FILE 2>/dev/null || echo "OFFLINE")
    RAM=$(free -m | awk '/Mem:/ { print $3 "/" $2 "MB" }')
    CPU=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}')%
    UPTIME=$(uptime -p)
    WARP_RAW=$(warp-cli status 2>/dev/null)
    [[ "$WARP_RAW" == *"Connected"* ]] && WARP_STATUS="${GREEN}Connected${NC}" || WARP_STATUS="${RED}Disconnected${NC}"

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "║  ${BRIGHT_GREEN}SYSTEM STATUS | POWERED BY GEMINI${NC}          ║"
    echo -e "╠══════════════════════════════════════════════════════════╣"
    echo -e "║  [${GREEN}●${NC}] NODE     : ${WHITE}$DOMAIN${NC}"
    echo -e "║  [${GREEN}●${NC}] MEMORY   : ${WHITE}$RAM${NC}"
    echo -e "║  [${GREEN}●${NC}] LOAD     : ${WHITE}$CPU Usage${NC}"
    echo -e "║  [${GREEN}●${NC}] WARP     : $WARP_STATUS"
    echo -e "║  [${GREEN}●${NC}] UPTIME   : ${WHITE}$UPTIME${NC}"
    echo -e "╠══════════════════════════════════════════════════════════╣"
    echo -e "║  ${CYAN}[01]${NC} MANAGEMENT USERS | ${CYAN}[02]${NC} DIAGNOSTICS | ${RED}[RR]${NC} RESET  ║"
    echo -e "║  ${CYAN}[00]${NC} TERMINATE SESSION                                 ║"
    echo -e "╚══════════════════════════════════════════════════════════╝"
    echo -ne "  ${BRIGHT_GREEN}root@xray-vps:${NC}${CYAN}#${NC} "
    read opt
    case $opt in
        1|01) menu_users ;;
        2|02) check_services ;;
        rr|RR) reinstall_script ;;
        0|00) exit ;;
        *) main_menu ;;
    esac
}

menu_users() {
    clear
    show_header
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "║  ${CYAN}[01]${NC} ADD TARGET  |  ${CYAN}[02]${NC} DEL TARGET  |  ${CYAN}[03]${NC} LIST      ║"
    echo -e "╚══════════════════════════════════════════════════════════╝"
    read -p "  Selection: " opt
    case $opt in
        1|01) add_user ;;
        2|02) del_user ;;
        3|03) list_user ;;
        *) main_menu ;;
    esac
}

list_user() {
    clear
    show_header
    USERS=$(jq -r '.inbounds[0].settings.clients[].email' $CONFIG_XRAY)
    [[ -z "$USERS" ]] && menu_users
    echo -e "${YELLOW}[?] Select Target Profile:${NC}"
    select USERNAME in $USERS "CANCEL"; do
        [[ "$USERNAME" == "CANCEL" ]] && menu_users
        UUID=$(jq -r ".inbounds[0].settings.clients[] | select(.email==\"$USERNAME\") | .id" $CONFIG_XRAY)
        PASS=$(jq -r ".inbounds[1].settings.clients[] | select(.email==\"$USERNAME\") | .password" $CONFIG_XRAY)
        show_links "$USERNAME" "$UUID" "$PASS"; break
    done
}

del_user() {
    clear
    show_header
    USERS=$(jq -r '.inbounds[0].settings.clients[].email' $CONFIG_XRAY)
    select USERNAME in $USERS "CANCEL"; do
        [[ "$USERNAME" == "CANCEL" ]] && menu_users
        for i in {0..6}; do jq ".inbounds[$i].settings.clients |= del(.[] | select(.email == \"$USERNAME\"))" $CONFIG_XRAY > tmp.json && mv tmp.json $CONFIG_XRAY; done
        rm -f $SUB_DIR/$USERNAME
        systemctl restart xray; menu_users; break
    done
}

check_services() {
    clear
    show_header
    echo -e "Xray  : $(systemctl is-active xray)"
    echo -e "Nginx : $(systemctl is-active nginx)"
    read -p "  Press Enter..."
    main_menu
}

reinstall_script() {
    systemctl stop xray nginx 2>/dev/null
    rm -rf /usr/local/etc/xray/
    rm -rf $SUB_DIR/*
    install_all
}

check_install() {

    if [[ -f "$CONFIG_XRAY" && -s "$CONFIG_XRAY" ]]; then
        main_menu
    else
        install_all
    fi
}

check_install
